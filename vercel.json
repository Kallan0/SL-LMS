{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "root": "frontend",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
